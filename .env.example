# Firebase Configuration (Client-side - public)
NEXT_PUBLIC_FIREBASE_API_KEY="REDACTED_ROTATED_GOOGLE_KEY"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="hustleapp-production.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="hustleapp-production"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="hustleapp-production.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="335713777643"
NEXT_PUBLIC_FIREBASE_APP_ID="1:335713777643:web:209e728afd5aee07c80bae"

# Firebase Admin SDK (Server-side - private)
# Get service account JSON from: https://console.firebase.google.com/project/hustleapp-production/settings/serviceaccounts/adminsdk
FIREBASE_PROJECT_ID="hustleapp-production"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@hustleapp-production.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# App Configuration
NODE_ENV="development"
NEXT_PUBLIC_API_DOMAIN="http://localhost:3000"
NEXT_PUBLIC_WEBSITE_DOMAIN="http://localhost:3000"

# Anthropic Claude API (AI layer)
# Powers /api/ai/recommend and /api/players/[id]/dream-gym/ai-strategy.
# Get a key from: https://console.anthropic.com/
# When unset, AI endpoints fall back to deterministic offline responses.
ANTHROPIC_API_KEY=""

# Optional: Custom log retention (days)
LOG_RETENTION_DAYS="30"

# Email Configuration (approved MXroute SMTP account; server-side only)
# Obtain values through the existing private deployment configuration.
# Port 465 uses implicit TLS; port 587 requires SMTP_SECURE=false (STARTTLS).
SMTP_HOST=""
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM=""
# /api/health/email verifies TLS and authentication without sending mail.

# Stripe Billing (Phase 5)
# Get keys from: https://dashboard.stripe.com/test/apikeys
# Use test keys for development (sk_test_...), live keys for production (sk_live_...)
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key"
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_secret"

# Stripe Price IDs (set after creating products in Stripe Dashboard)
# Test mode price IDs for development
STRIPE_PRICE_ID_STARTER="price_test_starter_placeholder"
STRIPE_PRICE_ID_PLUS="price_test_plus_placeholder"
STRIPE_PRICE_ID_PRO="price_test_pro_placeholder"

# Billing Feature Switch (Phase 7 Task 6)
# Set to "false" to disable Stripe operations (checkout, portal, invoices)
# Plan limits and enforcement still work when disabled
# Use for: maintenance, Stripe API outages, testing, demo mode
BILLING_ENABLED="true"

# =============================================================================
# LEGACY (Archived - Read-Only Reference)
